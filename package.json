{
  "name": "address-findr",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "build": "next build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:boundaries": "node scripts/check-domain-boundaries.mjs",
    "dev": "next dev",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle:migrate": "drizzle-kit migrate",
    "drizzle:push": "drizzle-kit push",
    "drizzle:pull": "drizzle-kit pull",
    "drizzle:drop": "drizzle-kit drop",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "validate": "pnpm type-check && pnpm check && pnpm lint && pnpm check:boundaries && pnpm test",
    "eval:address": "vitest run --config vitest.eval.config.ts src/application/ademe/address-match.live.test.ts",
    "eval:precisement": "vitest run --config vitest.eval.config.ts src/application/listing/precisement-benchmark.live.test.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "@swc/core",
      "@parcel/watcher",
      "unrs-resolver",
      "protobufjs"
    ],
    "overrides": {
      "lodash": "^4.18.1",
      "postcss": "^8.5.10",
      "esbuild": "^0.28.0",
      "next": "^16.2.6"
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "biome check --write"
    ],
    "!(drizzle/**)*.json": [
      "biome format --write"
    ]
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.0",
    "@base-ui/react": "^1.4.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.75.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.217.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.217.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.217.0",
    "@opentelemetry/sdk-logs": "^0.217.0",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@react-email/components": "^1.0.12",
    "@supabase/supabase-js": "^2.106.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@valibot/to-json-schema": "^1.7.0",
    "@vercel/functions": "^3.6.0",
    "@vercel/otel": "^2.1.2",
    "ai": "^6.0.0",
    "autumn-js": "^1.2.43",
    "better-auth": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "docx-preview": "^0.3.7",
    "drizzle-orm": "^0.45.2",
    "file-type": "^22.0.1",
    "lucide-react": "^1.14.0",
    "mammoth": "^1.12.0",
    "mapbox-gl": "^3.31.0",
    "motion": "^12.38.0",
    "neverthrow": "^8.2.0",
    "next": "^16.2.6",
    "next-intl": "^4.11.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.10",
    "p-limit": "^7.3.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.7.284",
    "pino": "^10.3.1",
    "postgres": "^3.4.8",
    "posthog-js": "^1.376.4",
    "posthog-node": "^5.35.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "remark-gfm": "^4.0.1",
    "resend": "^6.10.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "uuid": "^14.0.0",
    "valibot": "^1.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zeroentropy": "^0.1.0-alpha.10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@commitlint/cli": "^21.0.0",
    "@commitlint/config-conventional": "^21.0.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.5.0",
    "@types/nodemailer": "^8.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "atmn": "^1.1.15",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-sort-json": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.0",
    "vitest": "^4.1.6"
  }
}
