# ──────────────────────────────────────
# App
# ──────────────────────────────────────
NODE_ENV=development
VERCEL_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
LOG_LEVEL=debug

# ──────────────────────────────────────
# Product Analytics (PostHog)
# ──────────────────────────────────────
# Project API key from PostHog → Settings → Project. Leave empty to disable
# analytics entirely (client init + server client both no-op when unset).
NEXT_PUBLIC_POSTHOG_KEY=
# Ingestion host. EU cloud (default): https://eu.i.posthog.com
# US cloud: https://us.i.posthog.com  ·  Self-hosted: your instance URL.
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ──────────────────────────────────────
# Database (Postgres)
# ──────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postgres"
DATABASE_SSL=allow

# ──────────────────────────────────────
# Auth (Better Auth)
# ──────────────────────────────────────
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional. Default 'common' (multi-tenant + personal accounts).
# Set to a specific Entra tenant ID to restrict sign-in to one org.
MICROSOFT_TENANT_ID=common

# ──────────────────────────────────────
# Security (openssl rand -hex 32)
# ──────────────────────────────────────
ENCRYPTION_KEY=

# ──────────────────────────────────────
# Email — provider selector
# ──────────────────────────────────────
# Which provider sends transactional email.
# Allowed: 'none' (default — no delivery, send() is a logged no-op)
#          'smtp' (e.g. Gmail SMTP — no domain required)
#          'resend' (requires verified domain in Resend dashboard)
# Boot validation: only the env vars of the selected provider must be set,
# so the default boots anywhere. Pick a real provider once something sends.
EMAIL_PROVIDER=none

# ── Resend (only required if EMAIL_PROVIDER=resend) ──
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# ── SMTP (only required if EMAIL_PROVIDER=smtp) ──
# Gmail example with App Password:
#   1. Enable 2-Step Verification on your Google account.
#   2. https://myaccount.google.com/apppasswords → create password (16 chars).
#   3. SMTP_USER must equal SMTP_FROM_EMAIL (Gmail rewrites otherwise).
# Limits: ~500 emails/day from a personal Gmail; upgrade to Resend + domain
# before scaling beyond a handful of invites.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
# Display name shown to recipients in the From field.
# If unset, the From field is just the raw email address (no fallback name).
# E.g. SMTP_FROM_NAME="Acme" → "Acme" <user@gmail.com>
SMTP_FROM_NAME=

# ──────────────────────────────────────
# AI (Vercel AI SDK)
# ──────────────────────────────────────
# OPTIONAL: leave empty to run without AI. Chat, routing, HyDE, the retrieval
# critic, transcription and image vision each degrade to a handled error.
OPENAI_API_KEY=
# Main chat model — used by GENERALIST and KNOWLEDGE agents (RAG, web, files).
# Allowed: gpt-5.5, gpt-5.4, gpt-5.4-mini, gpt-5.4-nano (see VISION_CAPABLE_CHAT_MODELS).
# Default gpt-5.4-mini for chat UX; escalate to gpt-5.4 when quality matters more than latency.
CHAT_MODEL=gpt-5.4-mini
# Cheap model — used by HELP agent and background tasks
# (router classify, post-stream critic, HyDE expand, retrieval critic).
# Allowed: gpt-5.4-nano (see CHEAP_CHAT_MODELS).
CHEAP_MODEL=gpt-5.4-nano

# Daily LLM spend cap per user in USD. Soft warning at 80%, hard reject at 100%.
# Counts all LLM calls (chat, router classify, image VLM). Dev environment bypasses.
LLM_DAILY_BUDGET_USD_PER_USER=2

# Retrieval: enable HyDE multi-query expansion + RRF fusion.
# Adds ~1 LLM call per retrieval (~500ms latency, ~$0.0001 per call).
# Improves recall on domain-specific vocabulary.
# Default OFF — adds 4× ZE quota usage + 1s+ latency per retrieval.
# Enable after real-ZE eval validates improvement on your data.
RETRIEVAL_USE_HYDE=false

# Retrieval: corrective-RAG retry loop. When enabled, a critic LLM assesses
# each retrieval result; if relevance is low, retries once with a rephrased query.
# Adds 1 LLM call per retrieval (~$0.0001) when on; 2 if a retry fires.
# Default ON. Adds ~500ms per retrieval; corrects bad first-pass retrievals.
RETRIEVAL_USE_CRAG=true

# Chat: post-stream coherence critic (analytics only — does not affect response).
# Runs in background after the response streams to the user, logs faithfulness/hallucination
# verdicts via shared/logger (visible in Vercel logs without OTLP backend).
# Default ON. Zero UX impact; ~$0.0003 per chat turn.
CHAT_POST_STREAM_CRITIC=true

# Brave Search API (optional, enables webSearch chat tool)
# https://api-dashboard.search.brave.com/
BRAVE_SEARCH_API_KEY=

# ──────────────────────────────────────
# Firecrawl — scraping des annonces immobilieres
# ──────────────────────────────────────
FIRECRAWL_API_KEY=
FIRECRAWL_TIMEOUT_MS=60000

# ──────────────────────────────────────
# Groq — inference rapide pour l'extraction de champs d'annonce
# ──────────────────────────────────────
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
LISTING_EXTRACTION_MODEL=openai/gpt-oss-120b

# ──────────────────────────────────────
# geo.api.gouv.fr — resolution de commune (code INSEE)
# API publique et gratuite, aucune clef. Le code INSEE est la clef de la base
# ADEME : un code postal ne suffit pas, il peut couvrir plusieurs communes.
# ──────────────────────────────────────
GEO_GOUV_BASE_URL=https://geo.api.gouv.fr
GEO_GOUV_TIMEOUT_MS=8000

# ──────────────────────────────────────
# ADEME — base publique des DPE (adresse du logement)
# API publique et gratuite, aucune clef.
# ──────────────────────────────────────
ADEME_BASE_URL=https://data.ademe.fr
ADEME_TIMEOUT_MS=15000

# ──────────────────────────────────────
# BDNB (CSTB) — caracteristiques du batiment
# API Open publique et gratuite, aucune clef. Complete l'annee de construction
# et le nombre de niveaux que l'ADEME laisse vides.
# ──────────────────────────────────────
BDNB_BASE_URL=https://api.bdnb.io
BDNB_TIMEOUT_MS=10000

# ──────────────────────────────────────
# BAN geocoder (IGN Geoplateforme) — verifies the raw address of a DPE row
# that ADEME never geocoded. Public and free, no key.
# ──────────────────────────────────────
GEOCODER_BASE_URL=https://data.geopf.fr/geocodage
GEOCODER_TIMEOUT_MS=5000

# ──────────────────────────────────────
# Mapbox — carte 3D qui montre l'adresse trouvee
# ──────────────────────────────────────
# Jeton PUBLIC (pk.…), jamais un jeton secret (sk.…) : il part dans le bundle
# navigateur. Creez un jeton dedie et restreignez-le aux URL de l'app — le jeton
# public par defaut du compte ne peut pas porter de restriction d'URL. Portees
# minimales : styles:read, styles:tiles, fonts:read. Laisser vide desactive la
# carte, le reste du produit continue de fonctionner.
# Facturation au chargement de carte : 50 000/mois offerts, puis 5 $/1000.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# ──────────────────────────────────────
# Google Street View Static API — street photo of each candidate address
# ──────────────────────────────────────
# Server key with "Street View Static API" enabled, restricted to that API.
# Never sent to the browser: images go through /api/street-view.
# Empty = cards without photos, the rest of the product keeps working.
# Metadata calls are free; an image is billed only when a panorama exists.
GOOGLE_MAPS_API_KEY=

# ──────────────────────────────────────
# Google Maps Embed API — explore the Street View panorama inside the app
# ──────────────────────────────────────
# BROWSER key, served to the page: never reuse GOOGLE_MAPS_API_KEY here (the
# app refuses to boot if both are equal). Create a dedicated key restricted by
# HTTP referrer to the app's domains (e.g. https://your-domain/*, plus
# http://localhost:3000/* for local dev) and, under API restrictions, to the
# "Maps Embed API" only. The Maps Embed API is free, with no per-load charge.
# Empty = clicking the Street View photo opens Google Maps in a new tab.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_API_KEY=

# ──────────────────────────────────────
# Payments (Autumn — billing over Stripe)
# ──────────────────────────────────────
# Secret key from the Autumn dashboard. Sandbox key (am_sk_test_…) for local/dev;
# production key (am_sk_live_…) in prod. Optional locally; required in production
# if billing is used.
# Plans/products live in autumn.config.ts; push with `pnpm dlx atmn push` (add -p for
# production). Connect Stripe inside the Autumn dashboard.
AUTUMN_SECRET_KEY=

# ──────────────────────────────────────
# File Storage (Supabase Storage)
# ──────────────────────────────────────
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_BUCKET=files
SUPABASE_STORAGE_HOST=

# ──────────────────────────────────────
# RAG (ZeroEntropy)
# ──────────────────────────────────────
# OPTIONAL: leave empty to run without RAG. The client fails fast with
# NOT_CONFIGURED instead of sending an unauthenticated request.
ZEROENTROPY_API_KEY=
ZEROENTROPY_API_URL=https://eu-api.zeroentropy.dev/v1

# OPTIONAL: shared secret for Vercel Cron (Authorization: Bearer <CRON_SECRET>)
# Leave empty to disable the cron endpoint — it then rejects every caller.
# Must be at least 16 characters when set. Generate: openssl rand -hex 32
CRON_SECRET=

# ──────────────────────────────────────
# Cache & Rate Limit (Upstash Redis)
# ──────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ──────────────────────────────────────
# Monitoring (OpenTelemetry — OTLP-compatible backends)
# ──────────────────────────────────────
# Local dev: docker run -p 3000:3000 langfuse/langfuse-otel-collector
#   then OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Self-hosted Langfuse: see docs/observability.md
# Self-hosted Phoenix: docker run -p 6006:6006 arizephoenix/phoenix
#   then OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=startup-boilerplate

# Sampling (production only — dev keeps all traces).
# parentbased_traceidratio + arg=0.1 = 10% of traces sampled.
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1
